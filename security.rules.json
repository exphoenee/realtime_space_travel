{
/*
 * ═══════════════════════════════════════════════════════════════
 *  Firebase Realtime Database Security Rules
 *  Project: realtimespacetravel-e74e3
 *
 *  RELATIONSHIP TO database.rules.json
 *  ───────────────────────────────────
 *  This file is the DOCUMENTED (commented) SOURCE. Its comment-free,
 *  GENERATED twin is `database.rules.json` — that is the file Firebase
 *  actually deploys (referenced by firebase.json → "database").
 *  Keep the two in sync: edit the rules here, then regenerate
 *  database.rules.json with the one-liner below.
 *
 *  CURRENT STATE: PHASE 1 is in effect — wallet + inventory are
 *  CLIENT-WRITABLE (".write": "auth != null && auth.uid == $uid").
 *  See the DEPLOYMENT PHASES section below.
 *
 *  HOW TO DEPLOY
 *  ─────────────
 *  A) Firebase Console (easiest):
 *     1. Open https://console.firebase.google.com/project/realtimespacetravel-e74e3/database
 *     2. Go to Realtime Database → Rules
 *     3. Paste the ENTIRE content of this file into the editor
 *     4. Click PUBLISH
 *     Note: The Console editor accepts /* comments *\/ and will strip them on save.
 *
 *  B) Firebase CLI (for CI/CD):
 *     Regenerate the comment-free database.rules.json twin, then deploy:
 *     node -e "require('fs').writeFileSync('database.rules.json',
 *       require('fs').readFileSync('security.rules.json','utf8')
 *         .replace(/\\/\\*[\\s\\S]*?\\*\\//g,''))"
 *     Then: npx firebase deploy --only database
 *     (CI runs: npx firebase-tools deploy --only hosting,database)
 *
 *  ═══════════════════════════════════════════════════════════════
 *  DEPLOYMENT PHASES
 *  ═══════════════════════════════════════════════════════════════
 *
 *  PHASE 1 (NOW):  wallet + inventory = user-writable
 *    Cloud Functions NOT yet deployed. The client writes credits
 *    and inventory directly via useShopStore.checkout/
 *    buyCredits/resetShop. Use the rules below as-is.
 *
 *  PHASE 2 (FUTURE): wallet + inventory = server-only (".write": false)
 *    When Cloud Functions awardWage and purchaseWithCredits are
 *    deployed, change wallet and inventory to ".write": false.
 *    Only Admin SDK / Cloud Functions will modify credits and
 *    owned items. The client reads but never writes these paths.
 *
 *  ═══════════════════════════════════════════════════════════════
 *  RTDB SCHEMA
 *  ═══════════════════════════════════════════════════════════════
 *
 *  users/
 *    {uid}/
 *      profile:   { displayName, photoURL, provider, isAnonymous, createdAt, lastLoginAt,
 *                   guestMergeClaimed (bool — per-account merge gate, REPLACEMENT for migratedFrom),
 *                   migratedFrom (DEPRECATED legacy — do NOT write new entries),
 *                   orphanDiscardedCredits (audit) }
 *      settings:  { activeShipId, activeMusicId, musicMuted, musicVolume, difficulty, language }
 *      wallet:    { credits }
 *      inventory:
 *        ships:      { <shipId>: true, ... }
 *        music:      { <musicId>: true, ... }
 *        exoplanets: { <exoplanetId>: true, ... }
 *      stats:     { bestServiceSeconds }
 *
 *  device_map/
 *    {deviceId}: "{firebaseAuthUid}"
 *
 *  ═══════════════════════════════════════════════════════════════
 *  GUEST DATA MIGRATION
 *  ═══════════════════════════════════════════════════════════════
 *
 *  When a guest user signs in with Google, their guest data is migrated
 *  from users/{deviceId} to users/{googleUid}. After migration:
 *    - users/{deviceId} is deleted
 *    - device_map/{deviceId} is deleted
 *    - All subsequent operations use users/{googleUid}
 *    - Access is granted via the "$key == auth.uid" condition below
 *
 *  ═══════════════════════════════════════════════════════════════
 */

  "rules": {
    /* ——— DEVICE MAP ——— */
    "device_map": {
      "$deviceId": {
        /*
         * Maps a persistent deviceId (from localStorage) to the current
         * Firebase auth UID. The /users rules check this map instead of
         * comparing auth.uid directly with the path segment, so the guest
         * identity survives sign-out / new anonymous login.
         *
         * Write: any authenticated user may write their deviceId mapping
         * to their own auth.uid OR delete it (data.val() == auth.uid).
         * The data.val() part allows the guest->Google migration to clean
         * up the device_map entry after copying data to users/{googleUid}.
         *
         * Read: no client reads this path; the /users rules access it via
         * root.child('device_map').
         */
        ".write": "auth != null && (newData.val() == auth.uid || data.val() == auth.uid)",
        ".read": false
      }
    },

    /* ——— USERS PUBLIC INDEX ——— */
    "usersPublic": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && $uid == auth.uid"
      }
    },

    /* ——— FRIENDS ——— */
    "friends": {
      "$uid": {
        ".read": "auth != null && $uid == auth.uid",
        /*
         * Write: allowed if:
         * 1. The owner of the friends list (add/remove own friends), OR
         * 2. The recipient of a pending friend request adding themselves to
         *    the sender's friends list at accept time. This checks that a
         *    friend request from $uid to auth.uid exists in auth.uid's inbox,
         *    and that the write only adds auth.uid as a child (newData.child(auth.uid) === true).
         *    This prevents the acceptor from writing arbitrary entries.
         */
        ".write": "auth != null && ($uid == auth.uid || (root.child('friendRequests').child(auth.uid).child($uid).exists() && newData.child(auth.uid).val() === true) || (data.child(auth.uid).val() === true && newData.child(auth.uid).val() === null))"
      }
    },

    /* ——— OUTGOING REQUESTS (sender-side mirror for real-time status) ——— */
    "outgoingRequests": {
      "$uid": {
        ".read": "auth != null && $uid == auth.uid",
        ".write": "auth != null && ($uid == auth.uid || root.child('friendRequests').child(auth.uid).child($uid).exists())"
      }
    },

    /* ——— FRIEND REQUESTS ——— */
    "friendRequests": {
      "$uid": {
        ".read": "auth != null && $uid == auth.uid",
        /*
         * Write: allowed if:
         * 1. The owner of the request inbox (accept/reject), OR
         * 2. The sender creating their own request entry (the child key matches their uid)
         * This allows user A to write to friendRequests/{userB}/{userA} because
         * newData.hasChild(auth.uid) checks that the child key matching auth.uid exists.
         */
        ".write": "auth != null && ($uid == auth.uid || newData.hasChild(auth.uid))"
      }
    },

    /* ——— CHATS ——— */
    "chats": {
      "$chatId": {
        "participants": {
          ".read": "auth != null && data.child(auth.uid).val() === true",
          ".write": "auth != null && (data.child(auth.uid).val() === true || newData.child(auth.uid).val() === true)"
        },
        "messages": {
          "$msgId": {
            /* Read/Write: any authenticated user can read/write messages.
             * Privacy is ensured by the chat ID format ({uid1}_{uid2} — random
             * 28-char UIDs nobody can guess). No dependency on the participants
             * node avoids race conditions with async initChat.
             * The participants node exists for identifying which chats a user has. */
            ".read": "auth != null",
            ".write": "auth != null"
          }
        },
        "unread": {
          "$uid": {
            ".read": "auth != null && $uid == auth.uid",
            /* Write: any authenticated user can write (for sendMessage
             * incrementing the recipient's counter). Only the owner can read
             * their own count. */
            ".write": "auth != null"
          }
        },
        "typing": {
          "$uid": {
            ".read": "auth != null",
            /* Write: each user can only set their own typing status. */
            ".write": "auth != null && $uid == auth.uid"
          }
        }
      }
    },

    /* ——— MULTIPLAYER SESSIONS ——— */
    "sessions": {
      "$sessionId": {
        /* Read: any authenticated user can read session data. This allows
         * searching for and listing sessions. */
        ".read": "auth != null",
        /* No .write at $sessionId level — cascading would override child rules.
         * Instead, each child has its own .write rule:
         * - host: creator sets it initially, current host can transfer
         * - status: only the host can change
         * - participants/$uid: own entry OR host manages
         * - createdAt: only on initial creation (no .write = first write from client is allowed?)
         *   Actually, without any .write on the parent or on createdAt, the first write
         *   from createSession() will fail! We need a rule that allows creating the
         *   session initially. Let's handle this: any auth can create a NEW session
         *   (data doesn't exist), but once created, only field-level rules apply. */
        ".write": "auth != null && !data.exists()",
        /* Host: only the creator can set it initially, or the current host can transfer */
        "host": {
          ".write": "auth != null && (!data.exists() || data.val() == auth.uid)"
        },
        /* Status: only the host can change */
        "status": {
          ".write": "auth != null && root.child('sessions').child($sessionId).child('host').val() == auth.uid"
        },
        "createdAt": {
          /* Created at creation — only writable when node doesn't exist yet */
          ".write": "auth != null && !data.exists()"
        },
        "participants": {
          "$uid": {
            /* Write: participants can only write their own entry.
             * The host also needs to remove/kick participants. */
            ".write": "auth != null && ($uid == auth.uid || root.child('sessions').child($sessionId).child('host').val() == auth.uid)"
          }
        }
      }
    },

    /* ——— WALL OF SHAME (public to friends) ——— */
    "walls": {
      "$uid": {
        /* Read: own uid OR friends can read failures/successes.
         * This is a top-level path (not under users/) so the friend
         * read rule evaluates without being blocked by the users/$key/.read gate. */
        ".read": "auth != null && ($uid == auth.uid || root.child('friends').child(auth.uid).child($uid).val() === true)",
        "failures": {
          ".write": "auth != null && $uid == auth.uid"
        },
        "successes": {
          ".write": "auth != null && $uid == auth.uid"
        }
      }
    },

    "users": {
      "$key": {
        /*
         * READ: the authenticated user may read their own data if either:
         *   1) The device_map maps this key to their auth.uid (guest session),
         *      OR
         *   2) The key is their own Firebase UID (after guest->Google migration).
         * This allows guest data to be migrated to users/{googleUid} and then
         * accessed directly without a device_map entry.
         *
         * NOTE: Friend read access is granted ONLY on the `failures` and
         * `successes` sub-nodes below — NOT at this level — to prevent
         * friends from reading wallet, inventory, settings, etc.
         */
        ".read": "auth != null && (root.child('device_map').child($key).val() == auth.uid || $key == auth.uid)",

        /* ——— PROFILE ——— */
        "profile": {
          /* Write: device owner (via device_map) OR own uid may update profile */
          ".write": "auth != null && (root.child('device_map').child($key).val() == auth.uid || $key == auth.uid)"
        },

        /* ——— SETTINGS ——— */
        "settings": {
          ".write": "auth != null && (root.child('device_map').child($key).val() == auth.uid || $key == auth.uid)"
        },

        /* ——— WALLET (credits) ——— */
        "wallet": {
          /*
           * PHASE 1: Allow client writes (Cloud Functions not yet deployed).
           * PHASE 2: Change to ".write": false — only Admin SDK / Cloud Functions write.
           */
          ".write": "auth != null && (root.child('device_map').child($key).val() == auth.uid || $key == auth.uid)"
        },

        /* ——— INVENTORY (owned items) ——— */
        "inventory": {
          /*
           * PHASE 1: Allow client writes (Cloud Functions not yet deployed).
           * PHASE 2: Change to ".write": false — only Admin SDK / Cloud Functions write.
           */
          ".write": "auth != null && (root.child('device_map').child($key).val() == auth.uid || $key == auth.uid)"
        },

        /* ——— STATS (e.g. bestServiceSeconds) ——— */
        "stats": {
          ".write": "auth != null && (root.child('device_map').child($key).val() == auth.uid || $key == auth.uid)"
        },

        /* ——— FAILURES (Wall of Shame) ——— */
        "failures": {
          /*
           * Read: own uid OR friends can read (for friend wall feature).
           * Write: own uid only.
           */
          ".read": "auth != null && ($key == auth.uid || root.child('friends').child(auth.uid).child($key).val() === true)",
          ".write": "auth != null && (root.child('device_map').child($key).val() == auth.uid || $key == auth.uid)"
        },

        /* ——— SUCCESSES (Wall of Shame) ——— */
        "successes": {
          ".read": "auth != null && ($key == auth.uid || root.child('friends').child(auth.uid).child($key).val() === true)",
          ".write": "auth != null && (root.child('device_map').child($key).val() == auth.uid || $key == auth.uid)"
        }
      }
    }
  }
}
