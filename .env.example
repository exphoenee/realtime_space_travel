# ==================================================
# Realtime Space Travel — Environment Configuration
# ==================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==================================================

# Debug mode — enables developer overlays & debug credits
VITE_DEBUG_MODE=false

# Firebase Configuration — get these from Firebase Console
# Project Settings → General → Your apps → Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Stripe secret key — used by scripts/create_payment_links.mjs (Node).
# Test key: sk_test_... · Live key: sk_live_...
# ⚠️ The VITE_ prefix means Vite inlines this into the client bundle — the key
# is readable by anyone who opens dist/assets/*.js. Rotate it in the Stripe
# Dashboard if a build using it ever ships publicly.
VITE_STRIPE_SECRET_KEY=
