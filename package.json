{
  "name": "space-travel-simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node -e \"let h=require('fs').readFileSync('dist/index.html','utf-8');require('fs').writeFileSync('dist/index.html',h.replace(/__BASE_HREF__/g,process.env.VITE_BASE_PATH||'/realtime_space_travel/'))\"",
    "build:firebase": "VITE_BASE_PATH=/ npm run build",
    "build:gh-pages": "VITE_BASE_PATH=/realtime_space_travel/ npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tensorflow-models/face-detection": "^1.0.3",
    "@tensorflow/tfjs": "^4.18.0",
    "firebase": "^12.16.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.11",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^4.1.9"
  }
}
